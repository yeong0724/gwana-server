<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.gwana.server.mapper.TokenMapper">
    <resultMap id="tokenResultMap" type="com.gwana.server.dto.token.Token">
        <id property="tokenId" column="token_id"/>
        <result property="userId" column="user_id"/>
        <result property="accessToken" column="access_token"/>
        <result property="refreshToken" column="refresh_token"/>
        <result property="accessTokenExpiresAt" column="access_token_expires_at"/>
        <result property="refreshTokenExpiresAt" column="refresh_token_expires_at"/>
        <result property="createdAt" column="created_at"/>
        <result property="createdBy" column="created_by"/>
        <result property="modifiedAt" column="modified_at"/>
        <result property="modifiedBy" column="modified_by"/>
    </resultMap>

    <select id="findTokenByUserId" resultMap="tokenResultMap">
        SELECT *
        FROM token
        WHERE user_id = #{userId}
    </select>

    <select id="findTokenByAccessToken" resultMap="tokenResultMap">
        SELECT *
        FROM token
        WHERE access_token = #{accessToken}
    </select>

    <insert id="createToken" parameterType="com.gwana.server.dto.token.Token" >
        INSERT INTO token(
            token_id,
            user_id,
            access_token,
            refresh_token,
            auth_access_token,
            access_token_expires_at,
            refresh_token_expires_at,
            created_at,
            created_by,
            modified_at,
            modified_by
        ) VALUES (
            #{tokenId},
            #{userId},
            #{accessToken},
            #{refreshToken},
            #{authAccessToken},
            #{accessTokenExpiresAt},
            #{refreshTokenExpiresAt},
            #{createdAt},
            #{createdBy},
            #{modifiedAt},
            #{modifiedBy}
        )
    </insert>


    <delete id="deleteTokenByUserId">
        DELETE FROM token
        WHERE user_id = #{userId}
    </delete>

    <delete id="deleteTokenByAccessToken">
        DELETE FROM token WHERE access_token = #{accessToken}
    </delete>
</mapper>